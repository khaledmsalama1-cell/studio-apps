{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "studio-apps entry",
  "type": "object",
  "required": ["id", "name", "category", "kind", "pricing", "tagline", "description", "links", "integration"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string" },
    "category": { "type": "string", "description": "One of the ids in categories.json" },
    "kind": { "enum": ["open-source", "service", "desktop", "skill", "mcp", "cli"] },
    "pricing": { "enum": ["free", "freemium", "paid"] },
    "license": { "type": "string" },
    "tagline": { "type": "string" },
    "description": { "type": "string" },
    "links": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^https://" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "integration": {
      "oneOf": [
        { "properties": { "type": { "const": "link" } } },
        { "properties": { "type": { "const": "folder" } } },
        { "properties": { "type": { "const": "keys" }, "keys": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" } } } },
        { "properties": { "type": { "const": "skills-repo" }, "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" } } },
        { "properties": { "type": { "const": "mcp" }, "name": { "type": "string" }, "config": { "type": "object" }, "keys": { "type": "array" }, "oauth": { "type": "boolean" } } }
      ]
    }
  }
}
