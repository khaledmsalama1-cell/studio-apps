{
  "id": "tavily",
  "name": "Tavily",
  "category": "research",
  "kind": "service",
  "pricing": "freemium",
  "tagline": "Web search API for agents",
  "description": "Real-time search and extraction. MCP server.",
  "links": {
    "Website": "https://tavily.com",
    "GitHub": "https://github.com/tavily-ai/tavily-mcp"
  },
  "integration": {
    "type": "mcp",
    "name": "tavily",
    "config": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "keys": [
      "TAVILY_API_KEY"
    ]
  },
  "tags": [
    "search",
    "web"
  ],
  "color": "#4F46E5"
}
